<?xml version="1.0" encoding="utf-8"?>
<!--
    The sign-in screen with no chrome of our own: Mozilla's page fills the
    whole stage from edge to edge, one floating back pill is the only control,
    and the success card and the choice pills appear above the page only when
    there is something to say. No header band, no spinner — the page paints
    itself and the device log carries everything else.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/webRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <WebView
        android:id="@+id/webSignInPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000" />

    <!-- The only control on the stage: one small pill, top-start, back. -->
    <TextView
        android:id="@+id/webBack"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/pill_bg"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/vazirmatn_semibold"
        android:gravity="center"
        android:minWidth="88dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/web_back"
        android:textColor="#FFE8112D"
        android:textSize="15sp" />

    <!-- Success: a green tick, the welcome line, the account, one button. -->
    <LinearLayout
        android:id="@+id/webDone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/web_success_title"
            android:src="@drawable/success_check" />

        <TextView
            android:id="@+id/webDoneTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:fontFamily="@font/vazirmatn_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/web_success_title"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/webDoneEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/vazirmatn_regular"
            android:gravity="center"
            android:textColor="#FF9A9AA0"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/webConnect"
            style="@style/Gozar.Login.Primary"
            android:layout_width="240dp"
            android:layout_height="56dp"
            android:layout_marginTop="34dp"
            android:text="@string/web_connect"
            app:cornerRadius="28dp" />
    </LinearLayout>

    <!-- When a person must choose: two pills, no paragraph, no log text. -->
    <FrameLayout
        android:id="@+id/webFallback"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="34dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/webRetry"
                android:layout_width="260dp"
                android:layout_height="54dp"
                android:backgroundTint="#FF232326"
                android:fontFamily="@font/vazirmatn_medium"
                android:text="@string/web_retry"
                android:textColor="#FFFFFFFF"
                app:cornerRadius="27dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/webOpenChrome"
                android:layout_width="260dp"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#FF232326"
                android:fontFamily="@font/vazirmatn_medium"
                android:text="@string/web_open_chrome"
                android:textColor="#FFE8112D"
                app:cornerRadius="27dp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
