<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_bg">

    <ImageView
        android:id="@+id/loginFox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/login_fox" />

    <View
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_login_fade" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/loginScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="64dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="144dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/login_card"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/login_card_line"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="24dp">

                    <TextView
                        android:id="@+id/loginTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/login_signin_title"
                        android:textAppearance="@style/TextAppearance.Gozar.HeadlineMedium"
                        android:textColor="@color/login_text" />

                    <TextView
                        android:id="@+id/loginSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/login_signin_sub"
                        android:textAppearance="@style/TextAppearance.Gozar.BodyMedium"
                        android:textColor="@color/login_text_dim" />

                    <TextView
                        android:id="@+id/loginWaitHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/login_wait_hint"
                        android:textAppearance="@style/TextAppearance.Gozar.BodySmall"
                        android:textColor="@color/login_text_dim" />

                    <FrameLayout
                        android:id="@+id/loginMailBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/loginSystemAccounts"
                            style="@style/Gozar.Login.Field"
                            android:hint="@string/login_email"
                            app:endIconContentDescription="@string/system_accounts"
                            app:endIconDrawable="@drawable/ic_account"
                            app:endIconMode="custom"
                            app:startIconDrawable="@drawable/ic_mail">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/loginMail"
                                style="@style/Gozar.Login.Input"
                                android:imeOptions="actionNext"
                                android:inputType="textEmailAddress"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/loginSecretBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/loginReveal"
                            style="@style/Gozar.Login.Field"
                            android:hint="@string/login_password"
                            app:endIconContentDescription="@string/login_show_password"
                            app:endIconDrawable="@drawable/ic_eye"
                            app:endIconMode="custom"
                            app:startIconDrawable="@drawable/ic_lock">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/loginSecret"
                                style="@style/Gozar.Login.Input"
                                android:imeOptions="actionDone"
                                android:inputType="textPassword"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </FrameLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/loginConfirmBox"
                        style="@style/Gozar.Login.Field"
                        android:layout_marginTop="14dp"
                        android:hint="@string/login_confirm"
                        android:visibility="gone"
                        app:startIconDrawable="@drawable/ic_lock">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/loginConfirm"
                            style="@style/Gozar.Login.Input"
                            android:imeOptions="actionDone"
                            android:inputType="textPassword"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/loginCodeBox"
                        style="@style/Gozar.Login.Field"
                        android:layout_marginTop="14dp"
                        android:hint="@string/login_code"
                        android:visibility="gone"
                        app:startIconDrawable="@drawable/ic_key">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/loginCode"
                            style="@style/Gozar.Login.Input"
                            android:imeOptions="actionDone"
                            android:inputType="number"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <FrameLayout
                        android:id="@+id/loginBridgeBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/loginBridgeHelp"
                            style="@style/Gozar.Login.Field"
                            android:hint="@string/login_bridge_hint"
                            app:endIconContentDescription="@string/login_bridge_help"
                            app:endIconDrawable="@drawable/ic_help"
                            app:endIconMode="custom"
                            app:startIconDrawable="@drawable/ic_alt_route">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/loginBridge"
                                style="@style/Gozar.Login.Input"
                                android:imeOptions="actionDone"
                                android:importantForAutofill="no"
                                android:inputType="textVisiblePassword|textNoSuggestions"
                                android:maxLength="2048"
                                android:maxLines="1"
                                android:saveEnabled="false" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/loginForgot"
                        style="@style/Gozar.Login.Link"
                        android:layout_gravity="end"
                        android:layout_marginTop="8dp"
                        android:text="@string/login_forgot" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/loginPrimary"
                            style="@style/Gozar.Login.Primary"
                            android:text="@string/login_action" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/loginProgress"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorColor="@android:color/white"
                            app:indicatorSize="24dp"
                            app:trackThickness="3dp" />
                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/loginStop"
                        style="@style/Gozar.Login.Stop"
                        android:layout_marginTop="12dp"
                        android:text="@string/login_stop"
                        android:visibility="gone"
                        app:icon="@drawable/ic_stop"
                        app:iconGravity="textStart"
                        app:iconTint="@color/login_accent" />

                    <TextView
                        android:id="@+id/loginError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.Gozar.BodySmall"
                        android:textColor="@color/login_accent"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/loginSwitch"
                        style="@style/Gozar.Login.Switch"
                        android:layout_marginTop="12dp"
                        android:text="@string/login_no_account" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/loginSavedAccounts"
                        style="@style/Gozar.Login.Switch"
                        android:text="@string/saved_accounts"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/loginCancelAdd"
                        style="@style/Gozar.Login.Switch"
                        android:text="@string/cancel"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/login_terms"
                        android:textAppearance="@style/TextAppearance.Gozar.LabelSmall"
                        android:textColor="@color/login_text_dim" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/loginTopBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/login_bg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start|center_vertical"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.Gozar.TitleLarge"
            android:textColor="@color/login_text" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end|center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/loginLogs"
                style="@style/Gozar.Login.Link"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/login_logs"
                app:icon="@drawable/ic_log"
                app:iconGravity="textStart"
                app:iconSize="20dp"
                app:iconTint="@color/login_accent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/loginLanguage"
                style="@style/Gozar.Login.Link"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/language"
                app:icon="@drawable/ic_language"
                app:iconGravity="textStart"
                app:iconSize="20dp"
                app:iconTint="@color/login_accent" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
