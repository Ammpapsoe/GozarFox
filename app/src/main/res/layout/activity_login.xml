<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_bg">

    <ImageView
        android:id="@+id/loginFox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/login_fox" />

    <View
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_login_fade" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="200dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_login_card"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/loginTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/login_signin_title"
                    android:textAppearance="@style/TextAppearance.Gozar.HeadlineMedium"
                    android:textColor="@color/login_text" />

                <TextView
                    android:id="@+id/loginSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/login_signin_sub"
                    android:textAppearance="@style/TextAppearance.Gozar.BodyMedium"
                    android:textColor="@color/login_text_dim" />

                <!-- Two ways in, one tap apart: the native form talks to the
                     core directly, the browser tab opens Mozilla's page. -->
                <LinearLayout
                    android:id="@+id/loginTabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/pill_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="5dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/loginTabForm"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/vazirmatn_medium"
                        android:gravity="center"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:maxLines="2"
                        android:minHeight="46dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="@string/login_tab_form"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp"
                        app:backgroundTint="#FFE8112D"
                        app:cornerRadius="21dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/loginTabWeb"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/vazirmatn_medium"
                        android:gravity="center"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:maxLines="2"
                        android:minHeight="46dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="@string/login_tab_web"
                        android:textColor="#FF9A9AA0"
                        android:textSize="13sp"
                        app:backgroundTint="#00000000"
                        app:cornerRadius="21dp" />
                </LinearLayout>

                <!-- The browser path can need a filter; say so before it bites. -->
                <TextView
                    android:id="@+id/loginWebWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/pill_bg"
                    android:fontFamily="@font/vazirmatn_regular"
                    android:lineSpacingExtra="4dp"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp"
                    android:text="@string/web_warning"
                    android:textColor="#FFFFC966"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/loginMailBox"
                    style="@style/Gozar.Login.Well"
                    android:layout_marginTop="24dp">

                    <ImageView
                        style="@style/Gozar.Login.Well.Icon"
                        android:contentDescription="@string/login_email"
                        android:src="@drawable/ic_mail" />

                    <EditText
                        android:id="@+id/loginMail"
                        style="@style/Gozar.Login.Well.Input"
                        android:hint="@string/login_email"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:maxLines="1" />

                    <ImageButton
                        android:id="@+id/loginSystemAccounts"
                        android:layout_width="44dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/system_accounts"
                        android:padding="12dp"
                        android:src="@drawable/ic_account"
                        android:tint="@color/login_accent" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/loginSecretBox"
                    style="@style/Gozar.Login.Well"
                    android:layout_marginTop="12dp">

                    <ImageView
                        style="@style/Gozar.Login.Well.Icon"
                        android:contentDescription="@string/login_password"
                        android:src="@drawable/ic_lock" />

                    <EditText
                        android:id="@+id/loginSecret"
                        style="@style/Gozar.Login.Well.Input"
                        android:hint="@string/login_password"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:maxLines="1" />

                    <ImageView
                        android:id="@+id/loginReveal"
                        style="@style/Gozar.Login.Well.Icon"
                        android:contentDescription="@string/login_show_password"
                        android:src="@drawable/ic_eye" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/loginConfirmBox"
                    style="@style/Gozar.Login.Well"
                    android:layout_marginTop="12dp"
                    android:visibility="gone">

                    <ImageView
                        style="@style/Gozar.Login.Well.Icon"
                        android:contentDescription="@string/login_confirm"
                        android:src="@drawable/ic_lock" />

                    <EditText
                        android:id="@+id/loginConfirm"
                        style="@style/Gozar.Login.Well.Input"
                        android:hint="@string/login_confirm"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:maxLines="1" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/loginCodeBox"
                    style="@style/Gozar.Login.Well"
                    android:layout_marginTop="12dp"
                    android:visibility="gone">

                    <ImageView
                        style="@style/Gozar.Login.Well.Icon"
                        android:contentDescription="@string/login_code"
                        android:src="@drawable/ic_key" />

                    <EditText
                        android:id="@+id/loginCode"
                        style="@style/Gozar.Login.Well.Input"
                        android:hint="@string/login_code"
                        android:imeOptions="actionDone"
                        android:inputType="number"
                        android:maxLines="1" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/loginForgot"
                    style="@style/Gozar.Login.Link"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:text="@string/login_forgot" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/loginPrimary"
                        style="@style/Gozar.Login.Primary"
                        android:text="@string/login_action" />

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/loginProgress"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorColor="@android:color/white"
                        app:indicatorSize="24dp"
                        app:trackThickness="3dp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/loginError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Gozar.BodySmall"
                    android:textColor="@color/login_accent"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/loginSwitch"
                    style="@style/Gozar.Login.Switch"
                    android:layout_marginTop="12dp"
                    android:text="@string/login_no_account" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/loginSavedAccounts"
                    style="@style/Gozar.Login.Switch"
                    android:text="@string/saved_accounts"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/loginCancelAdd"
                    style="@style/Gozar.Login.Switch"
                    android:text="@string/cancel"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/login_terms"
                    android:textAppearance="@style/TextAppearance.Gozar.LabelSmall"
                    android:textColor="@color/login_text_dim" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/loginLanguage"
        style="@style/Gozar.Login.Link"
        android:layout_gravity="top|end"
        android:layout_marginEnd="12dp"
        android:minHeight="48dp"
        android:text="@string/language"
        app:icon="@drawable/ic_language"
        app:iconGravity="textStart"
        app:iconSize="20dp"
        app:iconTint="@color/login_accent" />
</FrameLayout>
